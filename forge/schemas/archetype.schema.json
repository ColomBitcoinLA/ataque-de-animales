{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animal Forge Creature Archetype",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "family", "status", "skeleton", "anchors", "measurementRanges", "identity", "variantPolicy", "evolutionPolicy"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "family": { "enum": ["quadruped", "avian", "reptile"] },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED"] },
    "skeleton": {
      "type": "object",
      "required": ["id", "bones", "compatibleWith"],
      "properties": {
        "id": { "type": "string" },
        "bones": { "type": "array", "minItems": 1, "items": { "type": "string" } },
        "compatibleWith": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "anchors": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "measurementRanges": {
      "type": "object",
      "required": ["heightM", "shoulderHeightM", "lengthM", "bodyWidthM", "eyeDiameterM", "eyeGapM", "tailOffsetM", "crestMainCount", "toesPerPaw"],
      "additionalProperties": { "type": "array", "minItems": 2, "maxItems": 2, "items": { "type": "number" } }
    },
    "identity": {
      "type": "object",
      "required": ["requiredTraits"],
      "properties": { "requiredTraits": { "type": "array", "minItems": 1, "items": { "type": "string" } } }
    },
    "variantPolicy": {
      "type": "object",
      "required": ["allowedParams", "immutableTraits"],
      "properties": {
        "allowedParams": { "type": "array", "items": { "type": "string" } },
        "immutableTraits": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "evolutionPolicy": {
      "type": "object",
      "required": ["mustPreserve", "maxStage"],
      "properties": {
        "mustPreserve": { "type": "array", "items": { "type": "string" } },
        "maxStage": { "type": "integer", "minimum": 2 }
      }
    }
  }
}
