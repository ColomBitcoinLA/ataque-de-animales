{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animal Forge World Asset",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "assetId", "category", "dimensions", "pivot", "collision", "materials", "lods", "provenance"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "assetId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "category": { "enum": ["vegetation", "rock", "building", "interactive", "streetFurniture", "streetModule", "plazaModule"] },
    "dimensions": {
      "type": "object",
      "required": ["x", "y", "z"],
      "properties": {
        "x": { "type": "number", "exclusiveMinimum": 0 },
        "y": { "type": "number", "exclusiveMinimum": 0 },
        "z": { "type": "number", "exclusiveMinimum": 0 }
      }
    },
    "pivot": { "enum": ["base", "center"] },
    "collision": {
      "type": "object",
      "required": ["type", "size"],
      "properties": {
        "type": { "enum": ["box", "cylinder", "none"] },
        "size": { "type": "array", "minItems": 3, "maxItems": 3, "items": { "type": "number", "minimum": 0 } }
      }
    },
    "materials": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "lods": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "triangles"],
        "properties": {
          "level": { "type": "integer", "minimum": 0 },
          "triangles": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "files": {
      "type": "object",
      "properties": {
        "model": { "type": ["string", "null"] },
        "textures": { "type": "array", "items": { "type": "string" } }
      }
    },
    "provenance": {
      "type": "object",
      "required": ["origin", "license"],
      "properties": { "origin": { "type": "string" }, "license": { "type": "string" } }
    }
  }
}
