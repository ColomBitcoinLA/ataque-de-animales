{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animal Forge Variant",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "variantId", "speciesVisualId", "kind", "status", "overrides", "preservedTraits", "parentVariantId", "provenance"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "variantId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "speciesVisualId": { "type": "string" },
    "kind": { "enum": ["COSMETIC", "SEASONAL", "REGIONAL"] },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "REJECTED"] },
    "overrides": { "type": "object" },
    "preservedTraits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "parentVariantId": { "type": ["string", "null"] },
    "provenance": {
      "type": "object",
      "required": ["origin", "license"],
      "properties": { "origin": { "type": "string" }, "license": { "type": "string" } }
    }
  }
}
