{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animal Forge Evolution Link",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "evolutionId", "fromVisualId", "toVisualId", "stage", "preservedTraits", "allowedMorphs", "status", "provenance"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "evolutionId": { "type": "string", "pattern": "^[a-z][a-z0-9-]*(\\.[a-z0-9][a-z0-9-]*)+$" },
    "fromVisualId": { "type": "string" },
    "toVisualId": { "type": "string" },
    "stage": { "type": "integer", "minimum": 2 },
    "preservedTraits": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "allowedMorphs": { "type": "array", "items": { "type": "string" } },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED", "REJECTED"] },
    "provenance": {
      "type": "object",
      "required": ["origin", "license"],
      "properties": { "origin": { "type": "string" }, "license": { "type": "string" } }
    }
  }
}
