{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Animal Forge Art Bible",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "families", "palettes", "materials", "proportions", "eyes", "finishes", "lighting", "scales", "budgets"],
  "properties": {
    "schemaVersion": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "version": { "type": "string", "pattern": "^\\d+\\.\\d+\\.\\d+$" },
    "status": { "enum": ["DRAFT", "REVIEW", "APPROVED"] },
    "families": { "type": "object", "minProperties": 1 },
    "palettes": { "type": "object", "minProperties": 1 },
    "materials": { "type": "object", "minProperties": 1 },
    "proportions": { "type": "object" },
    "eyes": { "type": "object", "minProperties": 1 },
    "finishes": { "type": "array", "minItems": 1, "items": { "type": "string" } },
    "lighting": { "type": "object" },
    "scales": {
      "type": "object",
      "required": ["unit", "up", "forward", "groundY"],
      "properties": {
        "unit": { "const": "m" },
        "up": { "const": "+Y" },
        "forward": { "const": "+Z" },
        "groundY": { "type": "number" }
      }
    },
    "budgets": { "type": "object" }
  }
}
